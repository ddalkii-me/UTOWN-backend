# ==========================================
# UTown Backend Environment Variables
# ==========================================

# Database Configuration
DB_NAME=utown_db
DB_USERNAME=utown_user
DB_PASSWORD=utown_password
DB_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

# Application Configuration
APP_PORT=8080
SERVER_ADDRESS=0.0.0.0
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Configuration
# WARNING: DO NOT USE THIS DEFAULT KEY IN PRODUCTION!
# In production, generate a secure random 256-bit key (e.g. `openssl rand -hex 32`)
JWT_SECRET=DEV_ONLY_SECRET_CHANGE_IN_PRODUCTION_404E635266556A586E3272357538782F
JWT_EXPIRATION=86400000

